# Development: local HTTP only. Production requires HTTPS and COOKIE_SECURE=true.
APP_ENV=development
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Persistent SQLite file; do not use :memory: or a database URL.
DATABASE_PATH=chatbot.db
SESSION_TIMEOUT=300

# Google Gemini is optional. Empty keys select rule-based mode.
# Legacy GEMINI_API_KEY is also supported when GEMINI_API_KEYS is empty.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite
ROTATOR_COOLDOWN_SECONDS=300
GEMINI_TIMEOUT_SECONDS=8
GEMINI_MAX_ATTEMPTS=4

# WhatsApp provider: meta or fonnte. Fill only the selected provider.
WHATSAPP_PROVIDER=meta
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
# Explicit, supported Graph API version; review lifecycle before deployment.
META_API_VERSION=v23.0

FONNTE_TOKEN=
# Separate inbound Authorization secret; trusted relay may be required.
# Empty value falls back to FONNTE_TOKEN for compatibility.
FONNTE_WEBHOOK_SECRET=

# Empty BPS key still permits navigation to the configured official catalogs.
BPS_API_KEY=
BPS_CACHE_TTL=86400
# Optional brittle website fallback; disabled unless its current ID is verified.
BPS_SERVER_ACTION_ID=

# No default operator account. Generate a password hash; never store plaintext here.
OPERATOR_USERNAME=
OPERATOR_PASSWORD_HASH=
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
FLASK_SECRET_KEY=
