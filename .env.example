# Gunakan format .env yang sudah ada. Isi token provider yang dipilih.

# Google Gemini: pisahkan beberapa API key dengan koma.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite
ROTATOR_COOLDOWN_SECONDS=300

# Provider WhatsApp: meta atau fonnte.
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
# App Secret dari dashboard Meta diperlukan untuk menerima webhook bertanda tangan.
# Server lokal tetap dapat dimulai jika variabel ini belum diisi.
# META_APP_SECRET=

# Fonnte WhatsApp API.
FONNTE_TOKEN=

# BPS Web API (opsional untuk pencarian data resmi).
BPS_API_KEY=
