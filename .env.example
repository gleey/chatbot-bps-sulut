# File .env untuk konfigurasi token
# -----------------------------------

# Google Gemini API — multiple keys untuk rotasi otomatis (pisahkan dengan koma)
# Jika hanya 1 key, sistem tetap berjalan normal
GEMINI_API_KEYS="your_gemini_api_key_1,your_gemini_api_key_2"

# Model utama (dicoba pertama)
GEMINI_MODEL="gemini-3.5-flash"

# Model fallback (dicoba berurutan jika model utama gagal 429/404)
GEMINI_MODEL_FALLBACKS="gemini-flash-lite-latest,gemini-flash-latest"

# Cooldown rotator (detik) — berapa lama key/model yang gagal di-istirahatkan
ROTATOR_COOLDOWN_SECONDS=300

# WhatsApp Provider ("meta" atau "fonnte")
WHATSAPP_PROVIDER="meta"

# Meta WhatsApp Cloud API
META_ACCESS_TOKEN="your_meta_access_token_here"
META_PHONE_NUMBER_ID="your_phone_number_id_here"
META_VERIFY_TOKEN="your_verify_token_here"

# Fonnte WhatsApp API
FONNTE_TOKEN="your_fonnte_token_here"

# BPS Web API (untuk integrasi data resmi BPS di masa depan)
BPS_API_KEY="your_bps_api_key_here"
